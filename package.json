{
  "name": "convex-vue-nuxt-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "pnpm --filter @j-boardman/convex-vue run build && pnpm --filter @j-boardman/convex-nuxt run build",
    "changeset": "changeset",
    "dev": "pnpm build && node scripts/dev.mjs",
    "dev:showcase": "pnpm build && pnpm --filter @j-boardman/convex-showcase dev",
    "lint": "eslint .",
    "prepare": "git config core.hooksPath .githooks",
    "release": "pnpm verify && changeset publish",
    "test": "pnpm run test:unit && pnpm run test:module && pnpm run test:package",
    "test:live": "pnpm build && node scripts/run-live-tests.mjs",
    "test:module": "vitest run test/nuxt",
    "test:package": "node scripts/verify-packages.mjs",
    "test:types": "tsc --project test/types/tsconfig.json --noEmit",
    "test:unit": "vitest run --exclude 'test/nuxt/**'",
    "typecheck": "pnpm build && pnpm run typecheck:packages && pnpm run test:types",
    "typecheck:packages": "pnpm --recursive --if-present run typecheck",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "convex": "1.45.0",
    "eslint": "10.9.1",
    "publint": "0.3.24",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11",
    "vue": "3.5.42"
  }
}
