{
  "name": "@j-boardman/convex-nuxt",
  "version": "0.0.0",
  "description": "First-class Convex integration for Nuxt",
  "keywords": [
    "convex",
    "nuxt",
    "vue",
    "realtime",
    "ssr"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/module.mjs",
  "module": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./server": {
      "types": "./dist/runtime/server/index.d.ts",
      "import": "./dist/runtime/server/index.js",
      "default": "./dist/runtime/server/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j-boardman/convex-nuxt.git",
    "directory": "packages/nuxt"
  },
  "homepage": "https://github.com/j-boardman/convex-nuxt#readme",
  "bugs": {
    "url": "https://github.com/j-boardman/convex-nuxt/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "prepack": "pnpm run build",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@j-boardman/convex-vue": "workspace:*",
    "@nuxt/kit": "4.5.2",
    "@nuxt/schema": "4.5.2",
    "defu": "6.1.7",
    "h3": "1.15.11",
    "ohash": "2.0.12"
  },
  "peerDependencies": {
    "convex": "^1.45.0",
    "nuxt": "^4.5.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "1.0.3",
    "convex": "1.45.0",
    "nuxt": "4.5.2",
    "vue": "3.5.42"
  }
}
