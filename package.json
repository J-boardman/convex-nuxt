{
  "name": "convex-vue-nuxt-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "pnpm --filter @j-boardman/convex-vue run build && pnpm --filter @j-boardman/convex-nuxt run build",
    "changeset": "changeset",
    "dev": "pnpm run dev:prepare && node scripts/run-playgrounds.mjs",
    "dev:backend": "node scripts/run-playgrounds.mjs backend",
    "dev:nuxt": "node scripts/run-playgrounds.mjs nuxt",
    "dev:prepare": "pnpm --filter @j-boardman/convex-vue run build && pnpm --filter @j-boardman/convex-nuxt exec nuxt-module-build prepare && pnpm --filter @j-boardman/convex-playground-backend run codegen",
    "dev:vue": "node scripts/run-playgrounds.mjs vue",
    "lint": "eslint .",
    "prepare": "git config core.hooksPath .githooks",
    "preview": "pkg-pr-new publish --pnpm --previewVersion --packageManager=pnpm './packages/*'",
    "release": "pnpm verify && changeset publish",
    "test": "pnpm run test:unit && pnpm run test:module && pnpm run test:e2e && pnpm run test:package",
    "test:e2e": "playwright test",
    "test:module": "vitest run test/nuxt",
    "test:package": "node scripts/verify-packages.mjs",
    "test:live": "pnpm build && node scripts/run-live-tests.mjs",
    "test:live:against": "pnpm run test:live:browser && pnpm run test:live:static",
    "test:live:browser": "playwright test --config playwright.live.config.ts",
    "test:live:static": "node scripts/verify-nuxt-static.mjs",
    "test:unit": "vitest run --exclude 'test/nuxt/**'",
    "typecheck": "pnpm build && pnpm run typecheck:packages && pnpm run test:types",
    "typecheck:packages": "pnpm --recursive --if-present run typecheck",
    "test:types": "tsc --project test/types/tsconfig.json --noEmit",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "convex": "1.45.0",
    "eslint": "10.9.1",
    "pkg-pr-new": "0.0.86",
    "publint": "0.3.24",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11",
    "vue": "3.5.42"
  }
}
