{
  "name": "convex-vue-nuxt-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "lint": "eslint .",
    "prepare": "git config core.hooksPath .githooks",
    "test": "pnpm run build && vitest run",
    "typecheck": "pnpm run typecheck:packages && pnpm run test:types",
    "typecheck:packages": "pnpm --recursive --if-present run typecheck",
    "test:types": "tsc --project test/types/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "convex": "1.45.0",
    "eslint": "10.9.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11",
    "vue": "3.5.42"
  }
}
